# Banco de dados (SQLite local). Para produção pode trocar por Postgres.
DATABASE_URL="file:./dev.db"

# Segredo para assinar as sessões. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-este-valor-por-um-segredo-longo"

# Pasta onde as fotos dos recibos são guardadas
UPLOAD_DIR="./uploads"

# Moeda e fuso horário usados nas telas
NEXT_PUBLIC_MOEDA="USD"
NEXT_PUBLIC_FUSO="America/New_York"

# Os dois administradores criados pelo "npm run setup"
ADMIN1_NOME="Administrador"
ADMIN1_EMAIL="admin@tababog.com"
ADMIN1_SENHA="trocar123"
ADMIN2_NOME="Emanuel"
ADMIN2_EMAIL="emanuel@tababog.com"
ADMIN2_SENHA="trocar123"
