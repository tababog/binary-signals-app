# ---------- Banco de dados (Postgres) ----------
# Supabase: Project Settings > Database > Connection string.
#   DATABASE_URL = "Transaction pooler" (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   = "Session pooler" ou conexão direta (porta 5432)
# No computador, pode ser um Postgres local (as duas iguais).
DATABASE_URL="postgresql://postgres:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:SENHA@HOST:5432/postgres"

# ---------- Fotos dos recibos (Supabase Storage) ----------
# Project Settings > API: "Project URL" e a chave "service_role" (secreta, nunca coloque no navegador).
# Sem essas duas variáveis as fotos ficam na pasta UPLOAD_DIR (só serve rodando no próprio computador).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="comprovantes"
UPLOAD_DIR="./uploads"

# ---------- Login ----------
# Segredo para assinar as sessões. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-este-valor-por-um-segredo-longo"

# ---------- Telas ----------
NEXT_PUBLIC_MOEDA="USD"
NEXT_PUBLIC_FUSO="America/New_York"

# ---------- Administradores criados automaticamente ----------
# Preencha com e-mails e senhas REAIS. E-mail inválido ou senha de exemplo/curta (menos de 6) não cria o administrador.
ADMIN1_NOME="Alessandro de Oliveira"
ADMIN1_EMAIL=""
ADMIN1_SENHA=""
ADMIN2_NOME="Emanuel Lopez"
ADMIN2_EMAIL=""
ADMIN2_SENHA=""
