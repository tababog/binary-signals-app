// Valores em dinheiro são guardados em centavos (Int) para evitar erros de arredondamento.

generator client {
  provider = "prisma-client-js"
}

// Supabase: DATABASE_URL usa o pooler (porta 6543, ?pgbouncer=true) e DIRECT_URL a conexão direta (porta 5432).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// papel: "ADMIN" (acesso total) ou "FUNCIONARIO" (apenas ponto e próprio histórico)
model Usuario {
  id             String   @id @default(cuid())
  nome           String
  // Login por e-mail ou telefone: pelo menos um dos dois é obrigatório
  email          String?  @unique
  senhaHash      String
  papel          String   @default("FUNCIONARIO")
  telefone       String?
  funcao         String?
  valorHoraCent  Int      @default(0)
  // tipoPagamento: "HORA" ou "DIARIA"; vinculo: "FIXO" (funcionário) ou "HELPER" (temporário)
  tipoPagamento  String   @default("HORA")
  valorDiariaCent Int     @default(0)
  vinculo        String   @default("FIXO")
  // Idioma das telas: "pt", "en" ou "es"
  idioma         String   @default("pt")
  // Documento fiscal (obrigatório para helpers): tipoDocumento "EIN", "ITIN" ou "SSN"; documento formatado
  tipoDocumento  String?
  documento      String?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  // Link de convite / redefinição de senha: guarda só o hash SHA-256 do token enviado ao funcionário
  conviteHash    String?
  conviteExpira  DateTime?

  registros      RegistroPonto[]
  lancamentos    Lancamento[]
  visitas        Visita[]

  @@index([conviteHash])
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  documento String?
  telefone  String?
  email     String?
  endereco  String?
  observacoes String?
  criadoEm  DateTime @default(now())

  obras     Obra[]
  visitas   Visita[]
  orcamentos Orcamento[]
}

// tipo: "FORNECEDOR" (material) ou "SUBCONTRATADO" (subcontractor que recebe por serviço)
model Fornecedor {
  id        String   @id @default(cuid())
  tipo      String   @default("FORNECEDOR")
  licenca   String?
  seguroValidade DateTime?
  nome      String
  // Documento fiscal (1099/W-9): tipoDocumento "EIN" (empresa), "ITIN" ou "SSN" (pessoa física); documento formatado
  tipoDocumento String?
  documento String?
  telefone  String?
  email     String?
  endereco  String?
  categoria String?
  observacoes String?
  criadoEm  DateTime @default(now())

  lancamentos Lancamento[]
}

// status: "PLANEJADA", "EM_ANDAMENTO", "PAUSADA", "CONCLUIDA"
model Obra {
  id              String    @id @default(cuid())
  nome            String
  endereco        String?
  descricao       String?
  status          String    @default("PLANEJADA")
  valorContratoCent Int     @default(0)
  dataInicio      DateTime?
  dataPrevista    DateTime?
  progresso       Int       @default(0)
  // Ponto central da obra e distância máxima aceita para o ponto da equipe
  latitude        Float?
  longitude       Float?
  raioMetros      Int       @default(200)
  // Dias de trabalho previstos: usados para orçar a parte da obra nos custos fixos da empresa
  diasPrevistos   Int       @default(0)
  criadoEm        DateTime  @default(now())

  clienteId       String
  cliente         Cliente   @relation(fields: [clienteId], references: [id])

  orcamento       ItemOrcamento[]
  lancamentos     Lancamento[]
  registros       RegistroPonto[]
  referencia      TrabalhoReferencia?
  orcamentos      Orcamento[]
}

// categoria: "MATERIAL", "MAO_DE_OBRA", "SERVICO", "EQUIPAMENTO", "OUTROS"
model ItemOrcamento {
  id          String @id @default(cuid())
  obraId      String
  obra        Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)
  categoria   String
  descricao   String
  valorCent   Int
}

// Fluxo de caixa de cada obra (conta do cliente).
// tipo: "ENTRADA" (pagamento do cliente) ou "SAIDA" (despesa da obra)
model Lancamento {
  id            String      @id @default(cuid())
  obraId        String
  obra          Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tipo          String
  categoria     String
  descricao     String
  valorCent     Int
  data          DateTime
  formaPagamento String?
  comprovante   String?
  fornecedorId  String?
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  criadoPorId   String
  criadoPor     Usuario     @relation(fields: [criadoPorId], references: [id])
  criadoEm      DateTime    @default(now())

  @@index([obraId, data])
}

// valorHoraCent é copiado do funcionário no momento da entrada,
// assim aumentos de salário não alteram o custo de obras passadas.
model RegistroPonto {
  id            String    @id @default(cuid())
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])
  obraId        String
  obra          Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  entrada       DateTime
  saida         DateTime?
  valorHoraCent Int
  // Diarista: diária do dia (dividida entre as obras do dia pelas horas). custoCent é calculado ao fechar o ponto.
  valorDiariaCent Int     @default(0)
  custoCent     Int?
  latEntrada    Float?
  lngEntrada    Float?
  precisaoEntrada Float?
  latSaida      Float?
  lngSaida      Float?
  precisaoSaida Float?
  observacao    String?
  // true quando o administrador lançou as horas (sem GPS do funcionário)
  manual        Boolean   @default(false)

  @@index([usuarioId, entrada])
  @@index([obraId])
}

// Custos fixos recorrentes da empresa (overhead), rateados entre as obras pelos dias trabalhados.
// periodicidade: "SEMANAL", "MENSAL" ou "ANUAL"
model CustoFixo {
  id            String   @id @default(cuid())
  nome          String
  valorCent     Int
  periodicidade String   @default("MENSAL")
  ativo         Boolean  @default(true)
  // "PLANILHA:<item>" quando veio da média real da planilha de fluxo de caixa do Drive; vazio quando cadastrado à mão
  origem        String?
  criadoEm      DateTime @default(now())
}

// Gastos avulsos da empresa que não são de uma obra (ex.: ferramentas). Entram no custo fixo do mês em que ocorreram.
model GastoEmpresa {
  id          String   @id @default(cuid())
  descricao   String
  valorCent   Int
  data        DateTime
  comprovante String?
  criadoEm    DateTime @default(now())
}

// Banco de preços: trabalhos já feitos (antigos ou obras concluídas no app), base para precificar novos.
// tipoServico: chave de TIPOS_SERVICO; unidade: chave de UNIDADES (src/lib/constantes.ts)
model TrabalhoReferencia {
  id                String   @id @default(cuid())
  tipoServico       String
  // Subserviços (mesmos códigos da visita, ex.: "NOVO" ou "INTERNA,INTERNA.TETO")
  subServicos       String?
  descricao         String
  cidade            String?
  condado           String?
  quantidade        Float
  unidade           String
  data              DateTime?
  custoMaterialCent Int      @default(0)
  custoMaoObraCent  Int      @default(0)
  custoOutrosCent   Int      @default(0)
  dias              Int      @default(0)
  // Horas de mão de obra (equipe própria) gastas no trabalho
  horas             Float    @default(0)
  precoCobradoCent  Int
  observacoes       String?
  obraId            String?  @unique
  obra              Obra?    @relation(fields: [obraId], references: [id], onDelete: SetNull)
  criadoEm          DateTime @default(now())

  @@index([tipoServico])
}

// Visita ao cliente para levantamento e orçamento, antes de virar obra.
// status: "AGENDADA", "REALIZADA" ou "CANCELADA"; tipoServico: chave de TIPOS_SERVICO
model Visita {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  dataHora    DateTime
  endereco    String?
  // tipoServico: chave de TIPOS_SERVICO ou "P:<nome>" para um serviço criado em "Outros"
  tipoServico String?
  // Subserviços escolhidos, separados por vírgula (ex.: "INTERNA,INTERNA.TETO,EXTERNA")
  subServicos String?
  descricao   String?
  status      String   @default("AGENDADA")
  // Depois da visita: null = em negociação, "FECHOU" ou "SEM_INTERESSE" (encerra os follow-ups)
  resultado   String?
  // Quem vai à visita (Alessandro ou Emmanuel)
  responsavelId String?
  responsavel Usuario? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  // Lembretes na Google Agenda dos sócios: JSON { usuarioId: eventId } e o resultado do último envio
  eventosAgenda String?
  agendaStatus  String?
  criadoEm    DateTime @default(now())

  followUps   FollowUp[]
  orcamentos  Orcamento[]
  fotos       FotoVisita[]

  @@index([dataHora])
}

// Contato de acompanhamento com o cliente depois da visita (enviado pelo celular do administrador).
// canal: "WHATSAPP", "SMS" ou "EMAIL"
model FollowUp {
  id           String    @id @default(cuid())
  visitaId     String
  visita       Visita    @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  ordem        Int
  dataPrevista DateTime
  enviadoEm    DateTime?
  canal        String?

  @@index([dataPrevista])
}

// Cache das traduções automáticas de textos escritos pelos usuários (cada texto é traduzido uma vez por idioma).
model Traducao {
  id       String   @id @default(cuid())
  hash     String
  idioma   String
  texto    String
  criadoEm DateTime @default(now())

  @@unique([hash, idioma])
}

// Fotos tiradas na visita (levantamento do trabalho). Arquivo no mesmo armazenamento dos recibos.
model FotoVisita {
  id       String   @id @default(cuid())
  visitaId String
  visita   Visita   @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  arquivo  String
  criadoEm DateTime @default(now())
}

// Serviços digitados em "Outros" na visita; passam a aparecer como opção fixa.
model ServicoPersonalizado {
  id       String   @id @default(cuid())
  nome     String   @unique
  criadoEm DateTime @default(now())
}

// Orçamento para o cliente (etapa 6): sempre duas opções (ex.: Essencial e Premium), cada uma com itens de custo,
// dias previstos (custo fixo) e preço. status: "RASCUNHO", "ENVIADO", "APROVADO" ou "RECUSADO".
model Orcamento {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  visitaId    String?
  visita      Visita?  @relation(fields: [visitaId], references: [id], onDelete: SetNull)
  obraId      String?
  obra        Obra?    @relation(fields: [obraId], references: [id], onDelete: SetNull)
  // tipoServico/subServicos: os mesmos códigos da visita (TIPOS_SERVICO, "P:<nome>", SUBSERVICOS)
  tipoServico String?
  subServicos String?
  descricao   String?
  endereco    String?
  cidade      String?
  condado     String?
  quantidade  Float    @default(0)
  unidade     String   @default("SQFT")
  status      String   @default("RASCUNHO")
  // Perguntas da IA sobre o trabalho e as respostas do administrador (JSON: [{ pergunta, opcoes, resposta }])
  perguntas   String?
  // Pesquisa de preço de mercado (JSON: faixa, preço por unidade, fontes com link, resumo e data da consulta)
  mercado     String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  opcoes      OpcaoOrcamento[]

  @@index([clienteId])
}

model OpcaoOrcamento {
  id            String     @id @default(cuid())
  orcamentoId   String
  orcamento     Orcamento  @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  ordem         Int
  nome          String
  descricao     String?
  diasPrevistos Int        @default(0)
  // Preço final para o cliente; 0 = ainda não definido (a tela sugere 2x o custo)
  precoCent     Int        @default(0)
  itens         ItemOpcao[]
}

// categoria: chave de CATEGORIAS_DESPESA (material, mão de obra, delivery, permit...)
model ItemOpcao {
  id            String         @id @default(cuid())
  opcaoId       String
  opcao         OpcaoOrcamento @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  ordem         Int            @default(0)
  categoria     String
  descricao     String
  quantidade    Float          @default(1)
  unidade       String?
  custoUnitCent Int            @default(0)
  // De onde veio o preço (ex.: "Home Depot $34.98 · Lowe's $36.48 · 2026-10-28") e o link do produto
  fonte         String?
  fonteUrl      String?
}
